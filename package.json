{
  "name": "teacher-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Журнал спостережень асистента вчителя",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @journal/web",
    "build": "npm run build -w @journal/web",
    "preview": "npm run preview -w @journal/web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo:files": "npm run demo:files -w @journal/web"
  },
  "engines": {
    "node": ">=20"
  }
}
