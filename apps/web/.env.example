# Синхронізація між пристроями (необов'язково).
# Без цих змінних застосунок працює лише на цьому пристрої — як і раніше.
# Значення беруться в проєкті Supabase: Project Settings → API.
# Сюди йде ТІЛЬКИ анонімний ключ (anon / publishable). Service role key на клієнті неприпустимий.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Демо-дані в інтерфейсі налаштувань (1 — увімкнути).
VITE_ENABLE_DEMO=
